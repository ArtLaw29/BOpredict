    // Deadlines (Paris / Central European Time)
    const DEADLINE_ISO = "2026-10-26T20:00:00+01:00"; 
    const ADMIN_UNLOCK_ISO = "2026-10-26T23:00:00+01:00";

    // 2. SUPABASE CREDENTIALS
    const SUPABASE_URL = "https://ygdokukbermqxdwgmxuo.supabase.co";
    const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlnZG9rdWtiZXJtcXhkd2dteHVvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkxNDczOTcsImV4cCI6MjEwNDcyMzM5N30.288JpjYxiMGGvDhyQvqoPx8PIvt39xAvnP2buznvTR8";

    const db = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    // Official Nominees
    const NOMINEES = [
      "Jude Bellingham", "Pau Cubarsi", "Marc Cucurella", "Ousmane Dembélé",
      "Luis Diaz", "Bruno Fernandes", "Gabriel", "Erling Haaland",
      "Achraf Hakimi", "Harry Kane", "Khvitcha Kvaratskhelia", "Lamine Yamal",
      "Sadio Mané", "Marquinhos", "Lautaro Martinez", "Kylian Mbappé",
      "Nuno Mendes", "Lionel Messi", "Joao Neves", "Michael Olise",
      "Willian Pacho", "Julian Quinones", "Declan Rice", "Rodri",
      "Fabian Ruiz", "William Saliba", "Ferran Torres", "Dayot Upamecano",
      "Vinicius Junior", "Vitinha"
    ];

    const KOPA_NOMINEES = [
      "Kerim Alajbegovic", "Ayyoub Bouaddi", "Pau Cubarsi", "Yan Diomandé",
      "Lennart Karl", "Éli Junior Kroupi", "Lamine Yamal", "Johan Manzambi",
      "Ibrahim Maza", "Warren Zaïre-Emery"
    ];

    const YASHIN_NOMINEES = [
      "Yassine Bounou", "Thibaut Courtois", "Joan García", "Gregor Kobel",
      "Emiliano Martínez", "Édouard Mendy", "David Raya", "Matvey Safonov",
      "Unai Simón", "Vozinha"
    ];

    let currentLeague = null;
    let currentUser = null;
    let leaguePredictions = {};
    let officialResults = { top10: [], kopa: "", yashin: "" };
    let isLocked = false;
    let isAdminUnlocked = false;
    let draggedIndex = null;

    window.addEventListener('DOMContentLoaded', async () => {
      resolveLeagueAccess();
    });

    function resolveLeagueAccess() {
      const urlParams = new URLSearchParams(window.location.search);
      const urlCode = urlParams.get('code');
      const savedCode = localStorage.getItem('bdo_authenticated_code');

      const targetCode = (urlCode || savedCode || '').toUpperCase().trim();
      const matched = LEAGUES.find(l => l.code === targetCode);

      if (matched) {
        currentLeague = matched;
        localStorage.setItem('bdo_authenticated_code', matched.code);
        document.getElementById('gateScreen').classList.add('hidden');
        bootApp();
      } else {
        document.getElementById('gateScreen').classList.remove('hidden');
      }
    }

    function submitGateCode() {
      const inputVal = document.getElementById('gateCodeInput').value.toUpperCase().trim();
      const matched = LEAGUES.find(l => l.code === inputVal);
      const err = document.getElementById('gateError');

      if (matched) {
        err.classList.add('hidden');
        currentLeague = matched;
        localStorage.setItem('bdo_authenticated_code', matched.code);
        document.getElementById('gateScreen').classList.add('hidden');
        bootApp();
      } else {
        err.classList.remove('hidden');
      }
    }

    function leaveLeague() {
      if (confirm("Leave this league? You will need your invite link or code to sign back in.")) {
        localStorage.removeItem('bdo_authenticated_code');
        window.location.href = window.location.pathname;
      }
    }

    async function bootApp() {
      currentUser = localStorage.getItem(`bdo_user_${currentLeague.id}`) || currentLeague.members[0];
      if (!currentLeague.members.includes(currentUser)) currentUser = currentLeague.members[0];

      initUI();
      checkAllTimers();
      setInterval(checkAllTimers, 1000);
      await loadLeagueDataFromSupabase();
      renderTop10();
      renderNominees();
      renderAdminSlots();
      lucide.createIcons();
    }

    function initUI() {
      document.getElementById('leagueHeaderTitle').textContent = `Ballon d'Or 2026 — ${currentLeague.name}`;
      document.getElementById('leagueSubTitle').textContent = `${currentLeague.members.length} participants`;
      document.getElementById('friendsPicksHeader').textContent = `Ballots — ${currentLeague.name}`;

      const uPicker = document.getElementById('userPicker');
      uPicker.innerHTML = currentLeague.members.map(u => `<option value="${u}" ${u === currentUser ? 'selected' : ''}>${u}</option>`).join('');

      const fFilter = document.getElementById('friendViewFilter');
      fFilter.innerHTML = `<option value="ALL">All members (${currentLeague.members.length})</option>` + 
        currentLeague.members.map(u => `<option value="${u}">${u}'s ballot</option>`).join('');

      document.getElementById('kopaPicker').innerHTML = '<option value="">Select a player...</option>' + 
        KOPA_NOMINEES.map(k => `<option value="${k}">${k}</option>`).join('');
      document.getElementById('yashinPicker').innerHTML = '<option value="">Select a goalkeeper...</option>' + 
        YASHIN_NOMINEES.map(y => `<option value="${y}">${y}</option>`).join('');

      document.getElementById('adminKopaSelect').innerHTML = '<option value="">(Not yet announced)</option>' + 
        KOPA_NOMINEES.map(k => `<option value="${k}">${k}</option>`).join('');
      document.getElementById('adminYashinSelect').innerHTML = '<option value="">(Not yet announced)</option>' + 
        YASHIN_NOMINEES.map(y => `<option value="${y}">${y}</option>`).join('');
    }

    function switchUser(user) {
      currentUser = user;
      localStorage.setItem(`bdo_user_${currentLeague.id}`, currentUser);
      renderTop10();
      renderNominees();
      loadUserTrophies();
    }

    function getMyData() {
      return leaguePredictions[currentUser] || { top10: [], kopa: "", yashin: "" };
    }

    function loadUserTrophies() {
      const myData = getMyData();
      document.getElementById('kopaPicker').value = myData.kopa || "";
      document.getElementById('yashinPicker').value = myData.yashin || "";
    }

    function checkAllTimers() {
      const now = new Date();

      const deadline = new Date(DEADLINE_ISO);
      const diffUser = deadline - now;

      const banner = document.getElementById('lockBanner');
      const dot = document.getElementById('lockDot');
      const msg = document.getElementById('lockMessage');
      const cdown = document.getElementById('lockCountdown');

      if (diffUser <= 0) {
        isLocked = true;
        banner.className = "rounded-xl border p-3 text-xs flex items-center justify-between transition-colors bg-red-950/40 border-red-500/40";
        dot.className = "w-2.5 h-2.5 rounded-full bg-red-500";
        msg.textContent = "🔒 Predictions locked! The ceremony has begun.";
        cdown.textContent = "LOCKED";

        document.getElementById('btnSave').disabled = true;
        document.getElementById('btnSave').className = "w-full py-3 rounded-xl bg-slate-800 text-slate-500 font-bold text-xs uppercase tracking-wider cursor-not-allowed";
        document.getElementById('btnSave').textContent = "Submissions Closed";
        document.getElementById('btnClear').classList.add('hidden');
        document.getElementById('kopaPicker').disabled = true;
        document.getElementById('yashinPicker').disabled = true;
      } else {
        isLocked = false;
        banner.className = "rounded-xl border p-3 text-xs flex items-center justify-between transition-colors bg-slate-900/60 border-slate-800";
        dot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400";
        msg.textContent = `⏳ Predictions open until ${deadline.toLocaleDateString('en-GB')} at ${deadline.toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'})} (Paris time)`;
        
        const hours = Math.floor(diffUser / (1000 * 60 * 60));
        const minutes = Math.floor((diffUser % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diffUser % (1000 * 60)) / 1000);
        cdown.textContent = `${hours}h ${minutes}m ${seconds}s`;
      }

      const adminUnlock = new Date(ADMIN_UNLOCK_ISO);
      const diffAdmin = adminUnlock - now;
      const btnAdmin = document.getElementById('btnOpenAdmin');

      if (diffAdmin > 0) {
        isAdminUnlocked = false;
        btnAdmin.className = "px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-500 text-xs flex items-center gap-1.5 cursor-not-allowed opacity-75";
        const dHours = Math.floor(diffAdmin / (1000 * 60 * 60));
        const dMins = Math.floor((diffAdmin % (1000 * 60 * 60)) / (1000 * 60));
        btnAdmin.innerHTML = `<i data-lucide="lock" class="w-3.5 h-3.5"></i> Admin locked (available at 23:00 — in ${dHours}h ${dMins}m)`;
      } else {
        isAdminUnlocked = true;
        btnAdmin.className = "px-3 py-1.5 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-300 hover:bg-amber-500/20 text-xs flex items-center gap-1.5 transition";
        btnAdmin.innerHTML = `<span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span><i data-lucide="sliders" class="w-3.5 h-3.5"></i> Live Ceremony (Admin)`;
      }
      lucide.createIcons();
    }

    async function loadLeagueDataFromSupabase() {
      try {
        const { data: preds, error: pErr } = await db.from('bdo_predictions')
          .select('*')
          .eq('league_id', currentLeague.id);
        
        if (pErr) throw pErr;

        leaguePredictions = {};
        (preds || []).forEach(r => {
          leaguePredictions[r.username] = {
            top10: r.top10 || [],
            kopa: r.kopa || "",
            yashin: r.yashin || ""
          };
        });

        const { data: off, error: oErr } = await db.from('bdo_official_results').select('*').eq('id', 'current').maybeSingle();
        if (oErr) throw oErr;

        if (off) {
          officialResults = {
            top10: off.top10 || [],
            kopa: off.kopa || "",
            yashin: off.yashin || ""
          };
        }

        renderTop10();
        renderNominees();
        loadUserTrophies();
        updateLeaderboard();
        renderFriendsPicks();
      } catch (err) {
        console.error("Supabase sync error:", err);
      }
    }

    async function savePrediction() {
      if (isLocked) {
        alert("Predictions are locked!");
        return;
      }

      const myData = getMyData();
      myData.kopa = document.getElementById('kopaPicker').value;
      myData.yashin = document.getElementById('yashinPicker').value;

      if (myData.top10.length !== 10) {
        alert("Please select exactly 10 players to complete your Top 10!");
        return;
      }

      const saveBtn = document.getElementById('btnSave');
      saveBtn.disabled = true;
      saveBtn.textContent = "Saving...";

      const { error } = await db.from('bdo_predictions').upsert({
        league_id: currentLeague.id,
        username: currentUser,
        top10: myData.top10,
        kopa: myData.kopa,
        yashin: myData.yashin,
        updated_at: new Date().toISOString()
      });

      saveBtn.disabled = false;
      saveBtn.textContent = "Save My Prediction Online";

      if (error) {
        alert("Error: " + error.message);
      } else {
        alert(`Prediction for ${currentUser} saved successfully!`);
        await loadLeagueDataFromSupabase();
      }
    }

    function renderTop10() {
      const myData = getMyData();
      const container = document.getElementById('top10List');
      container.innerHTML = "";

      for (let i = 0; i < 10; i++) {
        const playerName = myData.top10[i];
        const slot = document.createElement('div');
        
        slot.className = `p-2 rounded-lg border flex items-center justify-between text-xs transition select-none ${
          playerName 
            ? 'bg-slate-900 border-slate-700 text-white hover:border-amber-500/40' 
            : 'border-dashed border-slate-800 bg-slate-950/40 text-slate-500'
        }`;

        if (!isLocked && playerName) {
          slot.draggable = true;
          slot.ondragstart = (e) => {
            draggedIndex = i;
            e.dataTransfer.effectAllowed = 'move';
            slot.classList.add('opacity-40');
          };
          slot.ondragend = () => {
            draggedIndex = null;
            renderTop10();
          };
        }

        if (!isLocked) {
          slot.ondragover = (e) => {
            e.preventDefault();
            slot.classList.add('drag-over');
          };
          slot.ondragleave = () => {
            slot.classList.remove('drag-over');
          };
          slot.ondrop = (e) => {
            e.preventDefault();
            slot.classList.remove('drag-over');
            if (draggedIndex !== null && draggedIndex !== i) {
              movePlayer(draggedIndex, i);
            }
          };
        }

        slot.innerHTML = `
          <div class="flex items-center gap-2 min-w-0">
            ${(playerName && !isLocked) ? `
              <span class="cursor-grab active:cursor-grabbing text-slate-500 hover:text-amber-400 px-0.5" title="Drag to reorder">
                <i data-lucide="grip-vertical" class="w-3.5 h-3.5"></i>
              </span>
            ` : ''}
            <span class="w-5 h-5 flex items-center justify-center font-bold text-[11px] ${i === 0 ? 'text-amber-400 font-black' : 'text-slate-400'}">
              ${i + 1}.
            </span>
            <span class="truncate font-medium">${playerName ? playerName : '<span class="text-slate-500 italic">Empty slot</span>'}</span>
          </div>

          ${(playerName && !isLocked) ? `
            <div class="flex items-center gap-1 flex-shrink-0">
              <button onclick="shiftPlayer(${i}, -1)" class="p-1 text-slate-500 hover:text-amber-300 rounded hover:bg-slate-800 ${i === 0 ? 'opacity-20 cursor-not-allowed' : ''}" ${i === 0 ? 'disabled' : ''} title="Move up">
                <i data-lucide="chevron-up" class="w-3.5 h-3.5"></i>
              </button>
              <button onclick="shiftPlayer(${i}, 1)" class="p-1 text-slate-500 hover:text-amber-300 rounded hover:bg-slate-800 ${i === myData.top10.length - 1 ? 'opacity-20 cursor-not-allowed' : ''}" ${i === myData.top10.length - 1 ? 'disabled' : ''} title="Move down">
                <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
              </button>
              <button onclick="removePlayer('${playerName}')" class="p-1 text-slate-500 hover:text-red-400 rounded hover:bg-slate-800 ml-1" title="Remove">
                <i data-lucide="x" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          ` : ''}
        `;
        container.appendChild(slot);
      }
      lucide.createIcons();
    }

    function movePlayer(fromIndex, toIndex) {
      if (isLocked) return;
      const myData = getMyData();
      if (!myData.top10[fromIndex]) return;

      const player = myData.top10.splice(fromIndex, 1)[0];
      if (toIndex >= myData.top10.length) {
        myData.top10.push(player);
      } else {
        myData.top10.splice(toIndex, 0, player);
      }

      renderTop10();
      renderNominees(document.getElementById('searchNominee').value);
    }

    function shiftPlayer(index, direction) {
      if (isLocked) return;
      const target = index + direction;
      const myData = getMyData();
      if (target < 0 || target >= myData.top10.length) return;

      const temp = myData.top10[index];
      myData.top10[index] = myData.top10[target];
      myData.top10[target] = temp;

      renderTop10();
      renderNominees(document.getElementById('searchNominee').value);
    }

    function renderNominees(filter = "") {
      const myData = getMyData();
      const container = document.getElementById('nomineesContainer');
      container.innerHTML = "";

      const query = filter.toLowerCase();
      const filtered = NOMINEES.filter(name => name.toLowerCase().includes(query));

      filtered.forEach(name => {
        const isSelected = myData.top10.includes(name);
        const div = document.createElement('div');
        div.className = `p-2 rounded border text-xs flex justify-between items-center transition ${
          isLocked ? 'cursor-not-allowed opacity-60 bg-slate-950 border-slate-900' :
          isSelected 
            ? 'bg-amber-950/20 border-amber-500/40 text-amber-200 opacity-50 pointer-events-none' 
            : 'bg-slate-950 border-slate-800 hover:border-slate-600 hover:bg-slate-900 cursor-pointer'
        }`;
        if (!isLocked) div.onclick = () => addPlayer(name);
        div.innerHTML = `
          <span>${name}</span>
          ${isSelected ? `<span class="text-[10px] font-mono bg-amber-400/20 text-amber-300 px-1.5 rounded">#${myData.top10.indexOf(name) + 1}</span>` : `<span class="text-slate-500">+</span>`}
        `;
        container.appendChild(div);
      });

      document.getElementById('dispoBadge').textContent = `${30 - myData.top10.length} left`;
    }

    function addPlayer(name) {
      if (isLocked) return;
      if (!leaguePredictions[currentUser]) leaguePredictions[currentUser] = { top10: [], kopa: "", yashin: "" };
      const myData = leaguePredictions[currentUser];
      if (myData.top10.length >= 10 || myData.top10.includes(name)) return;
      myData.top10.push(name);
      renderTop10();
      renderNominees(document.getElementById('searchNominee').value);
    }

    function removePlayer(name) {
      if (isLocked) return;
      const myData = getMyData();
      myData.top10 = myData.top10.filter(n => n !== name);
      renderTop10();
      renderNominees(document.getElementById('searchNominee').value);
    }

    function clearMyTop10() {
      if (isLocked) return;
      if (confirm("Clear your Top 10?")) {
        const myData = getMyData();
        myData.top10 = [];
        renderTop10();
        renderNominees(document.getElementById('searchNominee').value);
      }
    }

    function updateLeaderboard() {
      const tbody = document.getElementById('leaderboardRows');
      tbody.innerHTML = "";

      const revealedCount = (officialResults.top10 || []).filter(x => x && x.trim() !== "").length;
      document.getElementById('officialCountText').textContent = `${revealedCount} / 10 revealed`;

      const scores = currentLeague.members.map(u => {
        const uData = leaguePredictions[u] || { top10: [], kopa: "", yashin: "" };
        let points = 0;
        let exact = 0;

        (uData.top10 || []).forEach((player, idx) => {
          const officialIdx = (officialResults.top10 || []).indexOf(player);
          if (officialIdx !== -1) {
            const diff = Math.abs(officialIdx - idx);
            if (diff === 0) { points += 10; exact++; }
            else if (diff === 1) { points += 5; }
            else { points += 2; }
          }
        });

        let bonus = 0;
        if (officialResults.kopa && uData.kopa === officialResults.kopa) bonus += 5;
        if (officialResults.yashin && uData.yashin === officialResults.yashin) bonus += 5;

        return { 
          user: u, 
          points: points + bonus, 
          exact, 
          bonus,
          hasVoted: (uData.top10 || []).length === 10 
        };
      }).sort((a, b) => b.points - a.points);

      scores.forEach((s, idx) => {
        const tr = document.createElement('tr');
        tr.className = s.user === currentUser ? 'bg-amber-950/20 font-medium' : '';
        tr.innerHTML = `
          <td class="p-3.5 font-mono font-bold ${idx === 0 ? 'text-amber-400' : 'text-slate-400'}">#${idx + 1}</td>
          <td class="p-3.5 font-semibold ${s.user === currentUser ? 'text-amber-300' : ''}">
            ${s.user} ${!s.hasVoted ? '<span class="text-[10px] text-red-400 italic">(incomplete)</span>' : ''}
          </td>
          <td class="p-3.5 text-center text-slate-300 font-mono">${s.exact} / 10</td>
          <td class="p-3.5 text-center text-slate-300 font-mono">+${s.bonus} pts</td>
          <td class="p-3.5 text-right font-mono font-bold text-amber-400 text-sm">${s.points} pts</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function renderFriendsPicks(filterUser = "ALL") {
      const container = document.getElementById('friendsPicksContainer');
      container.innerHTML = "";

      const usersToRender = filterUser === "ALL" ? currentLeague.members : [filterUser];

      usersToRender.forEach(user => {
        const data = leaguePredictions[user] || { top10: [], kopa: "", yashin: "" };
        const card = document.createElement('div');
        const isMe = user === currentUser;
        card.className = `bg-slate-900/60 border ${isMe ? 'border-amber-500/40' : 'border-slate-800'} rounded-xl p-4 text-xs space-y-3 shadow-lg`;
        
        let picksHtml = '<ol class="space-y-1.5 list-decimal list-inside text-slate-300">';
        for (let i = 0; i < 10; i++) {
          const p = data.top10[i];
          const isExact = officialResults.top10 && officialResults.top10[i] && officialResults.top10[i] === p;
          const isPlaced = p && officialResults.top10 && officialResults.top10.includes(p);
          
          let badge = '';
          if (isExact) {
            badge = '<span class="float-right text-[10px] font-bold text-emerald-400 bg-emerald-950/60 px-1.5 py-0.5 rounded">+10</span>';
          } else if (isPlaced) {
            badge = '<span class="float-right text-[10px] font-medium text-amber-400/80 bg-amber-950/40 px-1.5 py-0.5 rounded">placed</span>';
          }

          picksHtml += `
            <li class="py-1 px-1.5 rounded border border-transparent ${isExact ? 'bg-emerald-950/20 border-emerald-500/30 text-emerald-200 font-semibold' : 'hover:bg-slate-950/50'}">
              <span class="font-normal ${p ? 'text-slate-200' : 'text-slate-600'}">${p || '— not selected —'}</span>
              ${badge}
            </li>
          `;
        }
        picksHtml += '</ol>';

        card.innerHTML = `
          <div class="flex items-center justify-between border-b border-slate-800 pb-2 font-bold">
            <div class="flex items-center gap-2">
              <span class="${isMe ? 'text-amber-300' : 'text-slate-200'} text-sm">${user}</span>
              ${isMe ? '<span class="text-[9px] bg-amber-400/20 text-amber-300 px-1.5 py-0.5 rounded uppercase">Me</span>' : ''}
            </div>
            <span class="text-[10px] ${data.top10.length === 10 ? 'text-emerald-400 bg-emerald-950/50' : 'text-red-400 bg-red-950/50'} px-2 py-0.5 rounded-full font-mono">
              ${data.top10.length}/10 chosen
            </span>
          </div>

          ${picksHtml}

          <div class="pt-2 border-t border-slate-800/80 text-[11px] text-slate-400 space-y-1 bg-slate-950/40 p-2 rounded-lg">
            <div class="flex justify-between items-center">
              <span>Kopa Trophy:</span>
              <b class="text-slate-200 ${officialResults.kopa && officialResults.kopa === data.kopa ? 'text-emerald-400' : ''}">${data.kopa || '—'}</b>
            </div>
            <div class="flex justify-between items-center">
              <span>Yashin Trophy:</span>
              <b class="text-slate-200 ${officialResults.yashin && officialResults.yashin === data.yashin ? 'text-emerald-400' : ''}">${data.yashin || '—'}</b>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
      lucide.createIcons();
    }

    function setTab(tab) {
      document.getElementById('tabProno').classList.toggle('hidden', tab !== 'prono');
      document.getElementById('tabScores').classList.toggle('hidden', tab !== 'scores');
      document.getElementById('tabPicks').classList.toggle('hidden', tab !== 'picks');

      document.getElementById('btnTabProno').className = tab === 'prono' ? 'text-amber-400 border-b-2 border-amber-400 pb-1 flex items-center gap-1.5 whitespace-nowrap' : 'text-slate-400 hover:text-slate-200 pb-1 flex items-center gap-1.5 whitespace-nowrap';
      document.getElementById('btnTabScores').className = tab === 'scores' ? 'text-amber-400 border-b-2 border-amber-400 pb-1 flex items-center gap-1.5 whitespace-nowrap' : 'text-slate-400 hover:text-slate-200 pb-1 flex items-center gap-1.5 whitespace-nowrap';
      document.getElementById('btnTabPicks').className = tab === 'picks' ? 'text-amber-400 border-b-2 border-amber-400 pb-1 flex items-center gap-1.5 whitespace-nowrap' : 'text-slate-400 hover:text-slate-200 pb-1 flex items-center gap-1.5 whitespace-nowrap';

      if (tab === 'picks') {
        const filterVal = document.getElementById('friendViewFilter').value;
        renderFriendsPicks(filterVal);
      }
      lucide.createIcons();
    }

    function renderAdminSlots() {
      const container = document.getElementById('adminSlotsContainer');
      container.innerHTML = "";

      for (let i = 0; i < 10; i++) {
        const currentVal = officialResults.top10[i] || "";
        const div = document.createElement('div');
        div.className = "flex items-center gap-2 text-xs";
        div.innerHTML = `
          <span class="w-8 font-mono font-bold text-slate-400 text-right">#${i + 1}:</span>
          <select id="admin_slot_${i}" class="flex-1 bg-slate-950 border border-slate-800 rounded p-1.5 text-slate-200 outline-none focus:border-amber-400">
            <option value="">(Not yet announced)</option>
            ${NOMINEES.map(n => `<option value="${n}" ${n === currentVal ? 'selected' : ''}>${n}</option>`).join('')}
          </select>
        `;
        container.appendChild(div);
      }
    }

    function openAdminModal() {
      if (!isAdminUnlocked) {
        const unlockDate = new Date(ADMIN_UNLOCK_ISO);
        alert(`Admin results entry is locked until ${unlockDate.toLocaleDateString('en-GB')} at ${unlockDate.toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'})} (Paris time).`);
        return;
      }

      renderAdminSlots();
      document.getElementById('adminKopaSelect').value = officialResults.kopa || "";
      document.getElementById('adminYashinSelect').value = officialResults.yashin || "";
      document.getElementById('adminModal').classList.remove('hidden');
    }

    function closeAdminModal() {
      document.getElementById('adminModal').classList.add('hidden');
    }

    async function applyOfficialResults() {
      if (!isAdminUnlocked) {
        alert("Action restricted: Entry is locked until 23:00.");
        return;
      }

      const newTop10 = [];
      for (let i = 0; i < 10; i++) {
        const val = document.getElementById(`admin_slot_${i}`).value;
        newTop10.push(val);
      }

      officialResults.top10 = newTop10;
      officialResults.kopa = document.getElementById('adminKopaSelect').value;
      officialResults.yashin = document.getElementById('adminYashinSelect').value;

      const { error } = await db.from('bdo_official_results').upsert({
        id: 'current',
        top10: officialResults.top10,
        kopa: officialResults.kopa,
        yashin: officialResults.yashin,
        updated_at: new Date().toISOString()
      });

      if (error) {
        alert("Error publishing results: " + error.message);
      } else {
        alert("Official results published! Standings updated across all leagues.");
        closeAdminModal();
        await loadLeagueDataFromSupabase();
      }
    }

    async function resetOfficialResults() {
      if (!isAdminUnlocked) return;
      if (confirm("Reset all official ceremony results?")) {
        officialResults = { top10: [], kopa: "", yashin: "" };
        await db.from('bdo_official_results').upsert({
          id: 'current',
          top10: [],
          kopa: "",
          yashin: "",
          updated_at: new Date().toISOString()
        });
        renderAdminSlots();
        closeAdminModal();
        await loadLeagueDataFromSupabase();
      }
    }
  </script>
</body>
