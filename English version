<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ballon d'Or 2026 — Predictor</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    body { background-color: #0b0f19; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .gold-gradient { background: linear-gradient(135deg, #FDE68A 0%, #D4AF37 50%, #92400E 100%); }
    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
    .drag-over { border-color: #f59e0b !important; background-color: rgba(245, 158, 11, 0.1) !important; }
  </style>
</head>
<body class="text-slate-100 min-h-screen flex flex-col selection:bg-amber-400 selection:text-black">

  <!-- PASSCODE GATE SCREEN -->
  <div id="gateScreen" class="fixed inset-0 bg-slate-950 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-800 max-w-sm w-full rounded-2xl p-6 text-center space-y-4 shadow-2xl">
      <span class="p-3 inline-block rounded-2xl gold-gradient text-black font-black text-xl">⚽</span>
      <div>
        <h2 class="text-base font-bold text-white">Join Your Private League</h2>
        <p class="text-xs text-slate-400 mt-1">Enter your group's invite code:</p>
      </div>
      <div class="space-y-2">
        <input type="text" id="gateCodeInput" placeholder="E.g.: DELAWARE" class="w-full uppercase text-center tracking-widest font-mono bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-amber-300 font-bold text-sm focus:outline-none focus:border-amber-400">
        <p id="gateError" class="text-xs text-red-400 hidden">Invalid code. Please check with your league admin.</p>
      </div>
      <button onclick="submitGateCode()" class="w-full py-2.5 rounded-xl gold-gradient text-black font-bold text-xs uppercase tracking-wider hover:opacity-95 transition">
        Enter League
      </button>
    </div>
  </div>

  <!-- MAIN APP -->
  <div id="appScreen">
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-40">
      <div class="max-w-5xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="p-2 rounded-lg gold-gradient text-black font-black text-xs">⚽ BDO</span>
          <div>
            <h1 id="leagueHeaderTitle" class="font-bold text-sm sm:text-base tracking-wide text-amber-300 leading-tight">League</h1>
            <p class="text-[10px] text-slate-400" id="leagueSubTitle">Private League</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1.5 bg-slate-950 border border-amber-500/40 rounded-lg px-2.5 py-1">
            <label class="text-[11px] text-slate-400 font-medium">Participant:</label>
            <select id="userPicker" onchange="switchUser(this.value)" class="bg-transparent text-amber-300 text-xs font-semibold focus:outline-none cursor-pointer">
              <!-- Populated dynamically -->
            </select>
          </div>
          <button onclick="leaveLeague()" title="Switch league" class="p-1.5 text-slate-500 hover:text-slate-300 rounded-lg bg-slate-950 border border-slate-800">
            <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-6 flex-1 w-full space-y-6">

      <!-- RULES & ONBOARDING BANNER -->
      <section class="rounded-2xl border border-amber-500/30 bg-gradient-to-br from-slate-900 via-slate-900 to-amber-950/20 p-4 sm:p-5 shadow-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-36 h-36 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="flex items-start justify-between gap-3 border-b border-slate-800/80 pb-3">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">🏆</span>
            <div>
              <h2 class="text-sm sm:text-base font-black text-amber-300 tracking-wide uppercase">Ballon d'Or 2026 Challenge</h2>
              <p class="text-[11px] text-slate-400">Show your friends who has the sharpest football knowledge.</p>
            </div>
          </div>
          <span class="text-[10px] font-mono uppercase bg-amber-400/10 text-amber-300 border border-amber-400/30 px-2 py-0.5 rounded-full whitespace-nowrap">
            Official Rules
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-3">
          <!-- Step 1 -->
          <div class="bg-slate-950/50 border border-slate-800/60 rounded-xl p-3 space-y-1">
            <div class="flex items-center gap-1.5 text-xs font-bold text-slate-200">
              <span class="w-4 h-4 rounded-full bg-amber-400 text-black flex items-center justify-center font-black text-[10px]">1</span>
              Select Your Profile
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Choose your name in the dropdown <b class="text-amber-300">at the top right</b>. This acts as your official ballot for the league.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="bg-slate-950/50 border border-slate-800/60 rounded-xl p-3 space-y-1">
            <div class="flex items-center gap-1.5 text-xs font-bold text-slate-200">
              <span class="w-4 h-4 rounded-full bg-amber-400 text-black flex items-center justify-center font-black text-[10px]">2</span>
              Rank Your Top 10
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Predict the final standings from 1st to 10th place, then pick your winners for the <b>Kopa</b> and <b>Yashin</b> trophies.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="bg-slate-950/50 border border-slate-800/60 rounded-xl p-3 space-y-1.5">
            <div class="flex items-center gap-1.5 text-xs font-bold text-amber-300">
              <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-400"></i>
              Scoring System
            </div>
            <ul class="text-[11px] text-slate-300 space-y-1 font-mono">
              <li class="flex justify-between items-center"><span>Exact position:</span> <b class="text-emerald-400">+10 pts</b></li>
              <li class="flex justify-between items-center"><span>1 rank off:</span> <b class="text-amber-300">+5 pts</b></li>
              <li class="flex justify-between items-center"><span>Inside Top 10:</span> <b class="text-slate-400">+2 pts</b></li>
              <li class="flex justify-between items-center"><span>Kopa / Yashin bonus:</span> <b class="text-amber-400">+5 pts each</b></li>
            </ul>
          </div>
        </div>

        <div class="mt-3 pt-2.5 border-t border-slate-800/60 flex items-center justify-between text-[10px] text-slate-400">
          <span>💡 Drag and drop or use the arrows to reorder players before hitting <b class="text-slate-300">Save Prediction</b>.</span>
        </div>
      </section>

      <!-- LOCK BANNER -->
      <div id="lockBanner" class="rounded-xl border p-3 text-xs flex items-center justify-between transition-colors bg-slate-900/60 border-slate-800">
        <div class="flex items-center gap-2">
          <span id="lockDot" class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          <span id="lockMessage" class="text-slate-300 font-medium">Checking deadline...</span>
        </div>
        <span id="lockCountdown" class="font-mono font-bold text-amber-400 text-xs"></span>
      </div>

      <!-- TABS -->
      <div class="flex items-center justify-between border-b border-slate-800 pb-2 text-sm font-semibold flex-wrap gap-2">
        <div class="flex gap-3 sm:gap-4 overflow-x-auto pb-1">
          <button onclick="setTab('prono')" id="btnTabProno" class="text-amber-400 border-b-2 border-amber-400 pb-1 flex items-center gap-1.5 whitespace-nowrap">
            <i data-lucide="edit-3" class="w-4 h-4"></i> My Predictions
          </button>
          <button onclick="setTab('scores')" id="btnTabScores" class="text-slate-400 hover:text-slate-200 pb-1 flex items-center gap-1.5 whitespace-nowrap">
            <i data-lucide="trophy" class="w-4 h-4"></i> League Standings
          </button>
          <button onclick="setTab('picks')" id="btnTabPicks" class="text-slate-400 hover:text-slate-200 pb-1 flex items-center gap-1.5 whitespace-nowrap">
            <i data-lucide="users" class="w-4 h-4"></i> League Ballots
          </button>
        </div>
        
        <button id="btnOpenAdmin" onclick="openAdminModal()" class="px-3 py-1.5 rounded-lg border text-xs flex items-center gap-1.5 transition">
          <!-- Populated dynamically -->
        </button>
      </div>

      <!-- TAB 1 : MY PICKS -->
      <div id="tabProno" class="grid grid-cols-1 md:grid-cols-12 gap-6">
        
        <div class="md:col-span-7 space-y-4">
          <div class="flex justify-between items-center">
            <p class="text-xs font-semibold text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
              <span>Your Official Top 10</span>
              <span class="text-[10px] text-slate-500 font-normal lowercase">(drag or use arrows)</span>
            </p>
            <button id="btnClear" onclick="clearMyTop10()" class="text-xs text-red-400 hover:underline">Clear list</button>
          </div>
          
          <div id="top10List" class="space-y-1.5"></div>

          <!-- Bonus Questions -->
          <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-3 mt-4">
            <p class="text-xs font-bold text-amber-300 uppercase tracking-wider flex items-center gap-1.5">
              <i data-lucide="medal" class="w-3.5 h-3.5"></i> Bonus Trophies (+5 pts each)
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] text-slate-400 mb-1">Kopa Trophy (U21):</label>
                <select id="kopaPicker" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-200 outline-none focus:border-amber-400">
                  <option value="">Select a player...</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] text-slate-400 mb-1">Yashin Trophy (Goalkeeper):</label>
                <select id="yashinPicker" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-200 outline-none focus:border-amber-400">
                  <option value="">Select a goalkeeper...</option>
                </select>
              </div>
            </div>
          </div>

          <button id="btnSave" onclick="savePrediction()" class="w-full py-3 rounded-xl gold-gradient text-black font-bold text-xs uppercase tracking-wider hover:opacity-95 transition shadow-lg shadow-amber-500/10">
            Save My Prediction Online
          </button>
        </div>

        <!-- Nominees List -->
        <div class="md:col-span-5 bg-slate-900/40 border border-slate-800 rounded-xl p-3 flex flex-col h-[680px]">
          <div class="pb-2 border-b border-slate-800 mb-2">
            <div class="flex justify-between items-center mb-1.5">
              <span class="text-xs font-bold text-slate-300 uppercase">30 Ballon d'Or Nominees</span>
              <span id="dispoBadge" class="text-[10px] bg-slate-800 text-amber-300 px-2 py-0.5 rounded-full font-mono"></span>
            </div>
            <input type="text" id="searchNominee" oninput="renderNominees(this.value)" placeholder="Filter by name..." class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-amber-400">
          </div>
          <div id="nomineesContainer" class="flex-1 overflow-y-auto space-y-1 pr-1"></div>
        </div>
      </div>

      <!-- TAB 2 : STANDINGS -->
      <div id="tabScores" class="hidden space-y-4">
        <div class="bg-slate-900/40 border border-slate-800 rounded-xl p-3 text-xs text-slate-400 flex items-center justify-between">
          <span>Official ceremony progress: <b id="officialCountText" class="text-amber-300">0 / 10 revealed</b></span>
          <button onclick="loadLeagueDataFromSupabase()" class="text-amber-400 hover:underline flex items-center gap-1">
            <i data-lucide="refresh-cw" class="w-3 h-3"></i> Refresh
          </button>
        </div>

        <div class="bg-slate-900/60 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950 text-slate-400 uppercase font-semibold border-b border-slate-800">
              <tr>
                <th class="p-3.5">Rank</th>
                <th class="p-3.5">Participant</th>
                <th class="p-3.5 text-center">Exact Picks (+10)</th>
                <th class="p-3.5 text-center">Trophy Bonuses</th>
                <th class="p-3.5 text-right">Total Points</th>
              </tr>
            </thead>
            <tbody id="leaderboardRows" class="divide-y divide-slate-800"></tbody>
          </table>
        </div>
      </div>

      <!-- TAB 3 : LEAGUE BALLOTS -->
      <div id="tabPicks" class="hidden space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-900/40 border border-slate-800 rounded-xl p-3 text-xs">
          <div>
            <span class="font-bold text-slate-200" id="friendsPicksHeader">League Ballots</span>
            <p class="text-slate-400 text-[11px] mt-0.5">Check and compare all member picks transparently.</p>
          </div>
          <div class="flex items-center gap-2">
            <label class="text-slate-400">Filter:</label>
            <select id="friendViewFilter" onchange="renderFriendsPicks(this.value)" class="bg-slate-950 border border-slate-800 rounded px-2.5 py-1 text-amber-300 outline-none">
              <!-- Populated dynamically -->
            </select>
          </div>
        </div>

        <div id="friendsPicksContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>

    </main>
  </div>

  <!-- ADMIN CEREMONY MODAL -->
  <div id="adminModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 max-w-lg w-full rounded-2xl p-5 max-h-[90vh] flex flex-col shadow-2xl">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></div>
          <h3 class="text-sm font-bold text-white uppercase tracking-wider">Live Ceremony — Official Entry</h3>
        </div>
        <button onclick="closeAdminModal()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>

      <p class="text-xs text-slate-400 my-3">
        Fill in each position as announced during the live broadcast. Scores for <b>all leagues</b> will recalculate instantly.
      </p>

      <div class="flex-1 overflow-y-auto space-y-2 pr-2 my-1" id="adminSlotsContainer"></div>

      <div class="pt-3 border-t border-slate-800 grid grid-cols-2 gap-2 text-xs">
        <div>
          <label class="block text-[10px] text-slate-400 mb-1">Official Kopa Winner:</label>
          <select id="adminKopaSelect" class="w-full bg-slate-950 border border-slate-800 rounded p-1.5 text-slate-200 text-xs outline-none">
            <option value="">(Not yet announced)</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] text-slate-400 mb-1">Official Yashin Winner:</label>
          <select id="adminYashinSelect" class="w-full bg-slate-950 border border-slate-800 rounded p-1.5 text-slate-200 text-xs outline-none">
            <option value="">(Not yet announced)</option>
          </select>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-800 flex justify-between items-center gap-2">
        <button onclick="resetOfficialResults()" class="text-xs text-red-400 hover:underline">Reset All</button>
        <div class="flex gap-2">
          <button onclick="closeAdminModal()" class="px-3 py-1.5 rounded-lg text-xs text-slate-400 hover:text-white">Close</button>
          <button onclick="applyOfficialResults()" class="px-4 py-2 bg-amber-400 text-black font-bold text-xs rounded-lg hover:bg-amber-300 transition">
            Publish & Recalculate
          </button>
        </div>
      </div>
    </div>
  </div>

